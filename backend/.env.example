# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seva_portal?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Bootstrap superadmin (used by prisma/seed.js — change immediately after first login)
SEED_SUPERADMIN_EMAIL=admin@sevaportal.com
SEED_SUPERADMIN_PASSWORD=ChangeMe123!

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Razorpay (leave blank to disable online payments — admins can still
# mark orders PAID manually from the dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email notifications (leave blank to disable — order confirmations, status
# updates, and completed-work alerts simply won't be emailed).
# FREE OPTIONS:
#   - Gmail: use an "App Password" (not your real password) — 500 emails/day free
#     SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<app password>
#   - Brevo (formerly Sendinblue): 300 emails/day free forever, no card required
#     SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   - Ethereal (fake SMTP for local testing only, emails never really send): https://ethereal.email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Seva Portal <no-reply@sevaportal.com>"

# Web Push notifications (100% free forever, no third-party account needed).
# Generate a key pair once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sevaportal.com
